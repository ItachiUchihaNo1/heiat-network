# App
NODE_ENV=development
APP_URL=http://localhost:3000
DOMAIN=example.com
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
OTP_PEPPER=replace-with-another-long-random-secret

# Database
DATABASE_URL=postgresql://heiat:change-me@db:5432/heiat?schema=public
POSTGRES_DB=heiat
POSTGRES_USER=heiat
POSTGRES_PASSWORD=change-me

# OTP / SMS
# development = code is printed in server logs and returned only in development
# webhook = POSTs {to,message} to your SMS gateway webhook
SMS_PROVIDER=development
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Video meeting
# Can be your self-hosted Jitsi domain, e.g. https://meet.example.com
JITSI_BASE_URL=https://meet.jit.si

# Bootstrap admin
ADMIN_PHONE=09120000000
SEED_DEMO_DATA=true

# Product
SESSION_DURATION_OPTIONS=30,45

# Media storage (persistent Docker volume)
UPLOAD_DIR=/data/uploads
